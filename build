#!/bin/bash

export GOPATH="${HOME}/src/cgpcli"

# если на целевой ОС не совпадает glibc, то собираем без зависимостей.
# результирующий файл, возможно, получится медленнее и большего размера.
export CGO_ENABLED=0

if   [ "$1" == "fmt" ]; then
    go $*
elif [ "$1" == "test" ]; then
    CGPUSER=postmaster CGPPASS=B4lbpK1GTEaypwJdbIZQaG go test -v
elif [ "$1" == "tidy" ]; then
    go mod tidy
elif [ "$1" == "vet" ]; then
    echo "vet..."
    go vet
else
    go build
fi
