#!/usr/bin/perl
use strict;
use warnings;

# Использование: ./cgp_check.pl library.go CLI.txt
my ($go_file, $cli_txt) = @ARGV;
die "Usage: $0 <source.go> <CLI.txt>\n" unless $go_file;

$cli_txt = 'docs/api/CLI.txt' unless $cli_txt;

# 1. Индексируем функции в Go файле
my %go_funcs;
open my $fh_go, '<', $go_file or die "Can't open $go_file: $!";
while (<$fh_go>) {
    # Извлекаем имя метода (экспортируемого)
    if (/func\s+\([^)]+\)\s+([A-Z]\w*)\s*\(/) {
        $go_funcs{lc $1} = $1;
    }
}
close $fh_go;

# 2. Парсим CLI.txt по разделам
my %sections;
my $current_section = "General Administration";

open my $fh_cli, '<', $cli_txt or die "Can't open $cli_txt: $!";
while (<$fh_cli>) {
    chomp;
    next if /^\s*$/;
    next if /^\s*[_]{10,}/; 

    # Определение начала раздела
    if (/^([A-Z][A-Za-z ]+ Administration)$|^([A-Z][A-Za-z ]+ Settings)$/) {
        $current_section = $+;
        next;
    }

    # Определение команды
    if (/^\s{3,10}([A-Z][A-Z0-9]{3,}(?:\s+[A-Z][A-Z0-9]*)*)/) {
        my $full_cmd = $1;
        my ($cmd) = split(/\s+/, $full_cmd);

        next if $cmd =~ /^(DELETE|PARAM|OFFSET|LEGACY|NAME|SHARED|FORCE|PATH|INTO|FILTER|COOKIE|ACCOUNTS|ALIASES|FORWARDERS)$/;

        $sections{$current_section}{$cmd} = 1;
    }
}
close $fh_cli;

# 3. Вывод отчета
print "CGP CLI IMPLEMENTATION REPORT (Active Sections Only)\n";
print "=" x 52 . "\n";

foreach my $sec (sort keys %sections) {
    my @cmds = sort keys %{$sections{$sec}};
    my @missing;
    my $found = 0;

    # Сначала считаем попадания
    foreach my $cmd (@cmds) {
        if (exists $go_funcs{lc $cmd}) {
            $found++;
        } else {
            push @missing, $cmd;
        }
    }

    # Выводим раздел только если есть хотя бы одна реализованная функция
    if ($found > 0) {
        print "\nSECTION: $sec\n";
        print "-" x (length($sec) + 9) . "\n";
        printf "Status: %d/%d implemented\n", $found, scalar @cmds;
        
        if (@missing) {
            print "Missing in Go SDK:\n";
            print "  - $_\n" for @missing;
        } else {
            print "  [+] All commands from this section are implemented!\n";
        }
    }
}
