#!/usr/bin/perl
use strict;
use warnings;

# Использование: ./cgp_check.pl library.go CLI.txt
my ($go_file, $cli_txt) = @ARGV;
die "Usage: $0 <source.go> <CLI.txt>\n" unless $go_file;

$cli_txt = 'docs/api/CLI.txt' unless $cli_txt;

# 1. Индексируем функции в Go файле
my %go_funcs;
open my $fh_go, '<', $go_file or die "Can't open $go_file: $!";
while (<$fh_go>) {
    # Извлекаем имя метода (экспортируемого)
    if (/func\s+\([^)]+\)\s+([A-Z]\w*)\s*\(/) {
        $go_funcs{lc $1} = $1;
    }
}
close $fh_go;

# 2. Парсим CLI.txt по разделам
my %sections;
my $current_section = "Unknown";

open my $fh_cli, '<', $cli_txt or die "Can't open $cli_txt: $!";
while (<$fh_cli>) {
    chomp;
    next if /^\s*$/;
    next if /^\s*[_]{10,}/; # Пропускаем линии подчеркивания

    # Определение начала раздела (строка без начальных пробелов)
    if (/^([A-Z][A-Za-z ]+ Administration)$|^([A-Z][A-Za-z ]+ Settings)$/) {
        $current_section = $+;
        next;
    }

    # Определение команды (отступ 3-10 пробелов и ВЕРХНИЙ РЕГИСТР)
    if (/^\s{3,10}([A-Z][A-Z0-0]{3,}(?:\s+[A-Z][A-Z0-9]*)*)/) {
        my $full_cmd = $1;
        # Извлекаем только саму команду (первое слово)
        my ($cmd) = split(/\s+/, $full_cmd);

        # Фильтруем ложные срабатывания (типа SHARED, FORCE, PATH)
        next if $cmd =~ /^(DELETE\s+|PARAM|OFFSET|LEGACY|NAME|SHARED|FORCE|PATH|INTO|FILTER|COOKIE|ACCOUNTS|ALIASES|FORWARDERS)$/;

        $sections{$current_section}{$cmd} = 1;
    }
}
close $fh_cli;

# 3. Вывод отчета
print "CGP CLI IMPLEMENTATION REPORT\n";
print "=" x 40 . "\n";

foreach my $sec (sort keys %sections) {
    print "\nSECTION: $sec\n";
    print "-" x (length($sec) + 9) . "\n";
    
    my @cmds = sort keys %{$sections{$sec}};
    my $found = 0;
    my @missing;

    foreach my $cmd (@cmds) {
        if (exists $go_funcs{lc $cmd}) {
            $found++;
        } else {
            push @missing, $cmd;
        }
    }

    printf "Status: %d/%d implemented\n", $found, scalar @cmds;
    if (@missing) {
        print "Missing:\n";
        print "  - $_\n" for @missing;
    }
}
